{
  "manifest_version": 3,
  "name": "Publish to All — Medium Inspector",
  "version": "0.5.0",
  "description": "Guarded Medium title and body fill with URL Import retired for the current story.",
  "action": {
    "default_title": "Inspect Medium page",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://medium.com/*"],
      "js": ["story-title.js", "story-body.js", "medium-retirement.js", "medium-editor-inspector.js", "medium-title-fill.js", "medium-body-fill.js", "medium-body-recovery.js", "medium-title-controls.js", "medium-fill.js", "inspector.js", "second-attempt.js", "medium-controls.js", "import-session.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
